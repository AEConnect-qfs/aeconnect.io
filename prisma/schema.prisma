// aeconnect.io self-serve AI case-processing — data model.
//
// SQLite for local dev; switch `provider` to "postgresql" + a Neon URL for the
// Netlify deploy (serverless-friendly). binaryTargets makes the client bundle
// runnable on Netlify's Lambda runtime.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  passwordHash      String
  name              String
  // Billing (spec §2 LOCKED). Trial gate is anchored here, not the browser.
  plan              String        @default("trial") // "trial" | "core"
  trialCasesUsed    Int           @default(0)
  subscribedAt      DateTime?
  esignaturePinHash String?
  createdAt         DateTime      @default(now())
  cases             Case[]
  assessments       Assessment[]
  fieldDecisions    FieldDecision[]
  auditLogs         AuditLog[]
  billingUsages     BillingUsage[]
}

model Case {
  id              String          @id @default(uuid())
  userId          String
  caseRef         String
  title           String
  sourceType      String          @default("text") // text | pdf | image | word | email | excel
  sourceText      String
  // pending -> ai_drafted -> in_review -> cleared
  status          String          @default("pending")
  // Metering (spec §2): first AI assessment per case is the billable unit.
  firstAssessedAt DateTime?
  // Human e-signature sign-off (spec §6 hard gate). Locks the record.
  signedOffAt     DateTime?
  esignatureMeta  String?
  lockedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessments     Assessment[]
  fieldDecisions  FieldDecision[]

  @@unique([userId, caseRef])
  @@index([userId])
}

model Assessment {
  id                 String   @id @default(uuid())
  caseId             String
  userId             String
  modelVersion       String
  seriousness        String
  meddraPt           String
  meddraCode         String
  soc                String
  causality          String
  causalityMethod    String
  expectedness       String
  regulatoryRequired String
  regulatoryTimeline String
  authorities        String // JSON array
  narrative          String
  confidenceJson     String // JSON: per-field confidence
  createdAt          DateTime @default(now())
  case               Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model FieldDecision {
  id           String   @id @default(uuid())
  caseId       String
  userId       String
  fieldKey     String
  decisionType String // "accept" | "override"
  aiValue      String
  finalValue   String
  reason       String?
  decidedAt    DateTime @default(now())
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// Append-only, hash-chained audit log (spec §7, 21 CFR Part 11). Per-user chain.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  caseId    String?
  action    String
  detail    String
  prevHash  String?
  hash      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Per-user monthly metering (spec §2/§4).
model BillingUsage {
  id             String   @id @default(uuid())
  userId         String
  billingMonth   String // "YYYY-MM"
  casesProcessed Int      @default(0)
  overageCases   Int      @default(0)
  amountDueCents Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, billingMonth])
  @@index([userId])
}
