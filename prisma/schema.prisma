// aeconnect.io self-serve AI case-processing — data model.
//
// PostgreSQL (local Postgres or Neon). binaryTargets makes the client bundle
// runnable on Netlify's Lambda runtime. Apply with `npx prisma db push`.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Neon connection string
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  passwordHash      String
  name              String
  // Billing (spec §2 LOCKED). Trial gate is anchored here, not the browser.
  plan              String        @default("trial") // "trial" | "core"
  trialCasesUsed    Int           @default(0)
  subscribedAt      DateTime?
  // Stripe billing linkage (set by the checkout webhook).
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String? // active | past_due | canceled | ...
  esignaturePinHash String?
  // Bumped to invalidate outstanding JWTs (logout, password reset, admin reset).
  sessionVersion    Int           @default(0)
  failedLoginCount  Int           @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime      @default(now())
  cases             Case[]
  assessments       Assessment[]
  fieldDecisions    FieldDecision[]
  auditLogs         AuditLog[]
  billingUsages     BillingUsage[]
  passwordResets    PasswordReset[]
}

model Case {
  id              String          @id @default(uuid())
  userId          String
  caseRef         String
  title           String
  sourceType      String          @default("text") // text | pdf | image | word | email | excel
  sourceText      String
  // pending -> ai_drafted -> in_review -> cleared
  status          String          @default("pending")
  // Metering (spec §2): first AI assessment per case is the billable unit.
  firstAssessedAt DateTime?
  // Retained from an earlier sign-off design. The workspace does not set these.
  signedOffAt     DateTime?
  esignatureMeta  String?
  lockedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessments     Assessment[]
  fieldDecisions  FieldDecision[]

  @@unique([userId, caseRef])
  @@index([userId])
}

model Assessment {
  id                 String   @id @default(uuid())
  caseId             String
  userId             String
  modelVersion       String
  // Prompt id that produced this draft. Empty on rows created before the column existed.
  promptVersion      String   @default("")
  seriousness        String
  meddraPt           String
  meddraCode         String
  soc                String
  causality          String
  causalityMethod    String
  expectedness       String
  regulatoryRequired String
  regulatoryTimeline String
  authorities        String // JSON array
  narrative          String
  confidenceJson     String // JSON: per-field confidence
  createdAt          DateTime @default(now())
  case               Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fieldDecisions     FieldDecision[]

  @@index([caseId])
}

model FieldDecision {
  id           String   @id @default(uuid())
  caseId       String
  userId       String
  fieldKey     String
  decisionType String // "accept" | "override"
  aiValue      String
  finalValue   String
  reason       String?
  // Which assessment this accept/override belongs to. Null on rows from before the column existed.
  assessmentId String?
  decidedAt    DateTime @default(now())
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([assessmentId])
}

// Single-use password reset. Rows with a null tokenHash only count toward the
// per-email rate limit (including addresses that have no account).
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String?
  emailKey  String
  tokenHash String?   @unique
  expiresAt DateTime?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([emailKey, createdAt])
  @@index([userId])
}

// Append-only, hash-chained audit log (spec §7, 21 CFR Part 11). Per-user chain.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  caseId    String?
  action    String
  detail    String
  prevHash  String?
  hash      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Per-user monthly metering (spec §2/§4).
model BillingUsage {
  id             String   @id @default(uuid())
  userId         String
  billingMonth   String // "YYYY-MM"
  casesProcessed Int      @default(0)
  overageCases   Int      @default(0)
  amountDueCents Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, billingMonth])
  @@index([userId])
}
