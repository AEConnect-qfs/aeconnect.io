# Postgres connection string. The Prisma schema uses the postgresql provider.
# Local example: postgresql://USER:PASSWORD@localhost:5432/aeconnect
# Production: a Neon (or other) pooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aeconnect"

# Secret for signing session JWTs. Use a long random value in production.
JWT_SECRET="dev-secret-change-me"

# AI provider. Leave LLM_PROVIDER unset to keep the previous behavior:
# Anthropic when ANTHROPIC_API_KEY is set, otherwise the deterministic mock.
# See DEPLOY.md, "Switching the AI provider".
# LLM_PROVIDER=""          # mock | anthropic | openai-compatible
# LLM_BASE_URL=""          # OpenAI-compatible root, e.g. http://127.0.0.1:11434/v1
# LLM_MODEL=""             # e.g. qwen2.5:1.5b — also overrides ANTHROPIC_MODEL
# LLM_API_KEY=""           # key for that host; Anthropic may use ANTHROPIC_API_KEY instead

# Anthropic (used when LLM_PROVIDER is unset or anthropic). Server-side only.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL=""       # optional; default claude-sonnet-5

# Stripe — only STRIPE_SECRET_KEY is required. The $20/mo price is defined inline
# in code (from PRICING), and the plan activates via checkout-confirm on return,
# so no price id or webhook secret is needed. When STRIPE_SECRET_KEY is unset,
# Subscribe activates Core directly (dev). STRIPE_WEBHOOK_SECRET is optional (a
# backup activation path); SITE_URL is the Checkout redirect base.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""    # optional — from the Stripe webhook endpoint (whsec_...)
SITE_URL=""                 # e.g. https://aeconnect.io (Checkout redirect base)

# Local dev server port.
PORT=8787
