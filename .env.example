# Local dev uses SQLite. For the Netlify deploy, set DATABASE_URL to a serverless
# Postgres (e.g. Neon) connection string and switch prisma provider to postgresql.
DATABASE_URL="file:./dev.db"

# Secret for signing session JWTs. Use a long random value in production.
JWT_SECRET="dev-secret-change-me"

# Anthropic API key for the AI assessment engine (server-side only — never shipped
# to the browser). Set in Netlify env vars for production.
ANTHROPIC_API_KEY=""

# Stripe — only STRIPE_SECRET_KEY is required. The $20/mo price is defined inline
# in code (from PRICING), and the plan activates via checkout-confirm on return,
# so no price id or webhook secret is needed. When STRIPE_SECRET_KEY is unset,
# Subscribe activates Core directly (dev). STRIPE_WEBHOOK_SECRET is optional (a
# backup activation path); SITE_URL is the Checkout redirect base.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""    # optional — from the Stripe webhook endpoint (whsec_...)
SITE_URL=""                 # e.g. https://aeconnect.io (Checkout redirect base)

# Local dev server port.
PORT=8787
