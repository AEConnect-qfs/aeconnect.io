# Postgres connection string. The Prisma schema uses the postgresql provider.
# Local example: postgresql://USER:PASSWORD@localhost:5432/aeconnect
# Production: a Neon (or other) pooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aeconnect"

# Secret for signing session JWTs. Use a long random value in production.
JWT_SECRET="dev-secret-change-me"

# AI provider. Leave LLM_PROVIDER unset to keep the previous behavior:
# Anthropic when ANTHROPIC_API_KEY is set, otherwise the deterministic mock.
# See DEPLOY.md, "Switching the AI provider".
# LLM_PROVIDER=""          # mock | anthropic | openai-compatible
# LLM_BASE_URL=""          # OpenAI-compatible root, e.g. http://127.0.0.1:11434/v1
# LLM_MODEL=""             # e.g. qwen2.5:1.5b — also overrides ANTHROPIC_MODEL
# LLM_API_KEY=""           # key for that host; Anthropic may use ANTHROPIC_API_KEY instead

# Anthropic (used when LLM_PROVIDER is unset or anthropic). Server-side only.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL=""       # optional; default claude-sonnet-5

# Stripe. Both the secret key and the webhook signing secret are required in
# production. Checkout does not grant Core when the secret key is missing.
# ALLOW_DEV_SUBSCRIBE=true is a local-only bypass and defaults off. Never set it
# on Netlify. The $20/mo price is defined in code; extra cases are not billed.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""    # required — signing secret from the Stripe webhook endpoint (whsec_...)
SITE_URL=""                 # e.g. https://aeconnect.io (Checkout and password-reset link base)
# ALLOW_DEV_SUBSCRIBE=true  # local only; leave unset

# Password reset email. Leave EMAIL_PROVIDER unset for local dev: the reset link
# is printed in the dev-server log and is not returned to the browser.
# On Netlify, set one of resend or postmark. An unset provider there refuses
# every reset request instead of writing the link into function logs.
# EMAIL_PROVIDER=resend     # resend | postmark | log
# EMAIL_API_KEY=""          # Resend API key, or Postmark server token
# EMAIL_FROM="AE Connect <noreply@aeconnect.io>"

# Local dev server port.
PORT=8787
